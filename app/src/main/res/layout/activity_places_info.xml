<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_places_info"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/light_blue1"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/info_place_image"
        android:layout_width="350dp"
        android:layout_height="350dp"
        android:layout_gravity="center"
        android:layout_marginTop="50dp"
        android:adjustViewBounds="true"
        android:contentDescription="@string/txt_place"
        android:scaleType="centerCrop"
        android:src="@drawable/img_iskcon" />

    <TextView
        android:id="@+id/info_place_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="30dp"
        android:layout_marginTop="15dp"
        android:fontFamily="@font/montserrat_semibold"
        android:text="@string/txt_place_name"
        android:textColor="@color/black1"
        android:textSize="25sp" />

    <TextView
        android:id="@+id/info_place_location"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="30dp"
        android:layout_marginTop="10dp"
        android:drawablePadding="5dp"
        android:fontFamily="@font/montserrat_medium"
        android:text="@string/txt_location_name"
        android:textColor="@color/black1"
        android:textSize="16sp"
        app:drawableStartCompat="@drawable/icon_location" />

    <TextView
        android:id="@+id/info_place_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="15dp"
        android:drawablePadding="5dp"
        android:fontFamily="@font/montserrat"
        android:justificationMode="inter_word"
        android:maxWidth="350dp"
        android:text="@string/txt_lorem"
        android:textColor="@color/black1"
        android:textSize="14sp" />

    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_gravity="center"
        android:layout_weight="1" />

    <LinearLayout
        android:id="@+id/view_getDirections"
        android:layout_width="350dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:elevation="5dp"
        android:background="@drawable/corner_views"
        android:orientation="horizontal"
        android:layout_marginBottom="30dp"
        android:padding="5dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start|center"
            android:layout_marginStart="10dp"
            android:fontFamily="@font/montserrat_medium"
            android:text="@string/txt_get_directions"
            android:textColor="@color/black1"
            android:textSize="16sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_gravity="center"
            android:layout_weight="1" />

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="@android:color/transparent"
            android:contentDescription="@string/txt_idk"
            android:layout_margin="5dp"
            android:src="@drawable/icon_arrow" />
    </LinearLayout>
</LinearLayout>